# Required
GOOGLE_API_KEY=your-gemini-api-key

# LLM
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite
LLM_RPM=5                 # requests/minute per the free tier; raise on a paid key (e.g. 60)
LLM_MOCK=0                # 1 = demo mode: deterministic mock agents, no API calls

# Debate
DEBATE_ROUNDS=2

# Storage / API
DB_PATH=storage/screener.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANALYSE_RATE_LIMIT_PER_MIN=10

# Scheduler (watchlist re-analysis after market close, price alerts)
SCHEDULER_ENABLED=1
WATCHLIST_REFRESH_HOUR=16
WATCHLIST_REFRESH_MINUTE=15
PRICE_ALERT_INTERVAL_SEC=600
